# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# MongoDB Atlas connection string (Kushagra owns src/config/db.js)
MONGO_URI=

# Long random string. Rotate it if it ever leaks.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed by CORS. Vite's dev server default; set to the Vercel URL in production.
CLIENT_URL=http://localhost:5173
